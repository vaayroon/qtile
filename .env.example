# Qtile monitor layout preferences
# Loaded by settings.py and consumed by utils/system.py.

# Optional serial priority (comma-separated). Keep empty to use port fallback.
# Example: QTILE_SCREEN_SERIAL_ORDER=12345678,87654321
QTILE_SCREEN_SERIAL_ORDER=

# Port fallback priority when serials are missing/partial.
QTILE_SCREEN_PORT_ORDER=DP-0,HDMI-0,DP-2

# Outputs treated as internal laptop panel.
# Include aliases used by your machine if connector names vary.
# Example: QTILE_INTERNAL_OUTPUTS=eDP-1,DP2
QTILE_INTERNAL_OUTPUTS=eDP-1

# Primary monitor selection when multiple displays are connected.
# Only consulted if more than one output is active.
# Example: QTILE_PRIMARY_MONITOR=HDMI-0
QTILE_PRIMARY_MONITOR=

# Phone mirror widget defaults (session values override these at runtime).
# Wireless target in adb connect format host:port.
# Example: QTILE_PHONE_MIRROR_WIRELESS_TARGET=192.168.1.15:5555
QTILE_PHONE_MIRROR_WIRELESS_TARGET=

# Optional fixed adb serial. Keep empty to auto-select first available device.
QTILE_PHONE_MIRROR_DEVICE=

# Optional binary overrides.
QTILE_PHONE_MIRROR_ADB_PATH=/opt/genymobile/adb
QTILE_PHONE_MIRROR_SCRCPY_PATH=scrcpy

# Behavior flags.
# true -> scrcpy starts with phone screen off (-S)
QTILE_PHONE_MIRROR_SCREEN_OFF=true
# Video preset: low (1024 px, 4M, 30 fps), balanced (1600 px, 8M, 60 fps)
# or high (native size, 16M, 60 fps).
QTILE_PHONE_MIRROR_QUALITY=balanced
# Video preset used when the device is connected over Wi-Fi (host:port or an
# adb-...._adb-tls-connect._tcp name): low, balanced or high. USB keeps QTILE_PHONE_MIRROR_QUALITY.
QTILE_PHONE_MIRROR_WIFI_QUALITY=low
# true -> forward the phone audio to the computer (default: off, --no-audio)
QTILE_PHONE_MIRROR_AUDIO=false
# true -> after a right-click device switch, reopen mirroring if it was running
QTILE_PHONE_MIRROR_RESTART_ON_SWITCH=true
# Seconds the Wi-Fi pairing QR (Mod+Shift+P) stays valid; clamped to 120-300.
QTILE_PHONE_MIRROR_PAIR_TTL=180
# true -> append device serial in widget status text
QTILE_PHONE_MIRROR_SHOW_DEVICE=false

# Scroll wheel media volume step (Android keyevent repeats).
QTILE_PHONE_MIRROR_VOLUME_STEP=5

# Terminal emulator spawned by the bar widgets' click actions (empty = /usr/bin/qterminal).
# mod + Return always opens kitty.
# Example: QTILE_TERMINAL=/usr/bin/kitty
QTILE_TERMINAL=

# Optional autostart script run once per login by the startup_once hook.
# Keep empty to use autostart.sh from this checkout. Its output goes to
# $XDG_DATA_HOME/qtile/autostart.log (default ~/.local/share/qtile/autostart.log).
# Example: QTILE_AUTOSTART_PATH=/home/you/bin/my-autostart.sh
QTILE_AUTOSTART_PATH=

# Optional bar widgets (default true). Accepts 1/true/yes/on or 0/false/no/off.
# Leave these commented to keep the default; set a line to false to hide that widget.
# QTILE_WIDGET_UPDATES=true
# QTILE_WIDGET_CRYPTO=true
# QTILE_WIDGET_THERMAL=true
# QTILE_WIDGET_NVIDIA=true
# QTILE_WIDGET_PHONE_MIRROR=true

